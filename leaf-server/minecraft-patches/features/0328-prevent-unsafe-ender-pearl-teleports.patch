+    private @Nullable Vec3 findPearlTarget(final ServerPlayer player, final ServerLevel level, final Vec3 position) {
+        final BlockPos containing = BlockPos.containing(position);
+
+        Vec3 target = new Vec3(containing.getX() + 0.5D, containing.getY(), containing.getZ() + 0.5D);
+
+        if (level.getBlockState(containing).is(Blocks.BARRIER) || level.getBlockState(containing.above()).is(Blocks.BARRIER)) {
+            target = findBarrierSafe(level, target);
+
+            if (target == null) {
+                return null;
+            }
+        }
+
+        return isTargetSafe(player, level, target) ? target : null;
+    }
+
+    private @Nullable Vec3 findBarrierSafe(final ServerLevel level, final Vec3 position) {
+        final BlockPos containing = BlockPos.containing(position);
+
+        final int x = containing.getX();
+        final int z = containing.getZ();
+
+        for (int y = containing.getY(); y >= level.getMinY(); y--) {
+            final BlockPos floorPosition = new BlockPos(x, y, z);
+            final BlockState floorState = level.getBlockState(floorPosition);
+
+            if (floorState.getCollisionShape(level, floorPosition).isEmpty() || floorState.is(Blocks.BARRIER)) {
+                continue;
+            }
+
+            return new Vec3(x + 0.5D, y + 1.0D, z + 0.5D);
+        }
+
+        return null;
+    }
+
+    private boolean isTargetSafe(final ServerPlayer player, final ServerLevel level, final Vec3 position) {
+        final AABB box = player.getDimensions(player.getPose()).makeBoundingBox(position).deflate(1.0E-7);
+
+        return level.noCollision(player, box);
+    }
+
