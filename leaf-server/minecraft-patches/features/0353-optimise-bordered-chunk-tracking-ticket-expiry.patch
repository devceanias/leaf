+
+                    break;
+                }
+                case CHUNK_TICKET_STAGE_GENERATING: {
+                    generatingQueue.enqueue(chunkKey);
+
+                    break;
+                }
+                case CHUNK_TICKET_STAGE_GENERATED: {
+                    if (sendChunk && !sentChunk && (asyncSender == null || !asyncSender.contains(chunkKey))) {
+                        sendQueue.enqueue(chunkKey);
+                    }
+
+                    if (tickChunk) {
