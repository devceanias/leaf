+                    }
+
+                    break;
+                }
+                case CHUNK_TICKET_STAGE_TICK: {
+                    if (sendChunk && !sentChunk && (asyncSender == null || !asyncSender.contains(chunkKey))) {
+                        sendQueue.enqueue(chunkKey);
+                    }
+
+                    break;
+                }
+                default: {
+                    throw new IllegalStateException("Unknown stage: " + ticketStage);
+                }
+            }
+        }
