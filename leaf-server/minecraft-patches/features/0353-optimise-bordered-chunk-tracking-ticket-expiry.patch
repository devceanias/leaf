+                    break;
+                }
+                case CHUNK_TICKET_STAGE_LOADING: {
+                    loadingQueue.enqueue(chunkKey);
+
+                    break;
+                }
+                case CHUNK_TICKET_STAGE_LOADED: {
+                    if (canGenerate || isLoadedChunkGeneratable(chunkX, chunkZ)) {
+                        genQueue.enqueue(chunkKey);
