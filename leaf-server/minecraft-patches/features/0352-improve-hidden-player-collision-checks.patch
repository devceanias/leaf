@@ -86,12 +87,27 @@ public class ShulkerBoxBlock extends BaseEntityBlock {
     }
 
     public static boolean canOpen(BlockState state, Level level, BlockPos pos, ShulkerBoxBlockEntity blockEntity) {
-        if (blockEntity.getAnimationStatus() != ShulkerBoxBlockEntity.AnimationStatus.CLOSED) {
+        return canOpen(state, level, pos, blockEntity, null);
+    }
+
+    public static boolean canOpen(
+        final BlockState state,
+        final Level level,
+        final BlockPos pos,
+        final ShulkerBoxBlockEntity entity,
+        final @Nullable Player player
+    ) {
+        if (entity.getAnimationStatus() != ShulkerBoxBlockEntity.AnimationStatus.CLOSED) {
             return true;
-        } else {
-            AABB aabb = Shulker.getProgressDeltaAabb(1.0F, state.getValue(FACING), 0.0F, 0.5F, pos.getBottomCenter()).deflate(1.0E-6);
-            return level.noCollision(aabb);
         }
+
+        final AABB aabb = Shulker
+            .getProgressDeltaAabb(1.0F, state.getValue(FACING), 0.0F, 0.5F, pos.getBottomCenter())
+            .deflate(1.0E-6);
+
+        return player == null
+            ? level.noCollision(aabb)
+            : VisibilityCollisions.noEntityCollisionForActor(level, player, null, aabb);
     }
 
     @Override
