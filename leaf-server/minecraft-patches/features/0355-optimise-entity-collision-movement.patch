     // Paper end - utility for reading an entity from a nullable entity reference via a UUIDLookup
+
+    @SuppressWarnings("unchecked")
+    private @Nullable Entity leaf$getEntity(final Level level) {
+        final Optional<StoredEntityType> stored = this.entity.right();
+
+        if (stored.isPresent()) {
+            final StoredEntityType current = stored.get();
+
+            if (!current.isRemoved()) {
+                return (Entity) current;
+            }
+
+            this.entity = Either.left(current.getUUID());
+        }
+
+        final Optional<UUID> uuid = this.entity.left();
+
+        if (uuid.isEmpty()) {
+            return null;
+        }
+
+        final Entity entity = level.getEntityInAnyDimension(uuid.get());
+
+        if (entity == null || entity.isRemoved()) {
+            return null;
+        }
+
+        this.entity = Either.right((StoredEntityType) entity);
+
+        return entity;
+    }
+
+    @SuppressWarnings("unchecked")
+    private @Nullable LivingEntity leaf$getLivingEntity(final Level level) {
+        final Optional<StoredEntityType> stored = this.entity.right();
+
+        if (stored.isPresent()) {
+            final StoredEntityType current = stored.get();
+
+            if (!current.isRemoved()) {
+                return (LivingEntity)current;
+            }
+
+            this.entity = Either.left(current.getUUID());
+        }
+
+        final Optional<UUID> uuid = this.entity.left();
+
+        if (uuid.isEmpty()) {
+            return null;
+        }
+
+        if (!(level.getEntityInAnyDimension(uuid.get()) instanceof final LivingEntity living) || living.isRemoved()) {
+            return null;
+        }
+
+        this.entity = Either.right((StoredEntityType) living);
+
+        return living;
+    }
+
+    @SuppressWarnings("unchecked")
+    private @Nullable Player leaf$getPlayer(final Level level) {
+        final Optional<StoredEntityType> stored = this.entity.right();
+
+        if (stored.isPresent()) {
+            final StoredEntityType current = stored.get();
+
+            if (!current.isRemoved()) {
+                return (Player)current;
+            }
+
+            this.entity = Either.left(current.getUUID());
+        }
+
+        final Optional<UUID> uuid = this.entity.left();
+
+        if (uuid.isEmpty()) {
+            return null;
+        }
+
+        final Player player = level.getPlayerInAnyDimension(uuid.get());
+
+        if (player == null || player.isRemoved()) {
+            return null;
+        }
+
+        this.entity = Either.right((StoredEntityType) player);
+
+        return player;
+    }
 }
