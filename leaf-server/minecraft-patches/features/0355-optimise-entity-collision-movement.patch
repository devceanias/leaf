+    private int checkInsideStationary(
+        final Level level,
+        final Vec3 from,
+        final Vec3 to,
+        final AABB aabb,
+        final InsideBlockEffectApplier.StepBasedCollector stepBasedCollector,
+        final LongSet visited,
+        final int maxAllowedSteps
+    ) {
+        final int minX = Mth.floor(aabb.minX);
+        final int maxX = Mth.floor(aabb.maxX);
+        final int minY = Mth.floor(aabb.minY);
+        final int maxY = Mth.floor(aabb.maxY);
+        final int minZ = Mth.floor(aabb.minZ);
+        final int maxZ = Mth.floor(aabb.maxZ);
+
+        final @Nullable ChunkAccess[] cachedChunkAccess = { null };
+        final long[] cachedChunkPos = {Long.MIN_VALUE};
+
+        int index = 0;
+
+        final boolean hasIntersectionSubscriber = level instanceof final ServerLevel server
+            && server.getServer().debugSubscribers().hasAnySubscriberFor(DebugSubscriptions.ENTITY_BLOCK_INTERSECTIONS);
+
+        for (int y = minY; y <= maxY; ++y) {
+            for (int z = minZ; z <= maxZ; ++z) {
+                for (int x = minX; x <= maxX; ++x) {
+                    if (!isAlive()) {
+                        return index;
+                    }
+
+                    if (index >= maxAllowedSteps) {
+                        return index;
+                    }
+
+                    final int chunkX = x >> 4;
+                    final int chunkZ = z >> 4;
+
+                    final long currentChunkPos = ChunkPos.asLong(chunkX, chunkZ);
+
+                    final BlockState state;
+                    final BlockPos pos = new BlockPos(x, y, z);
+
+                    if (cachedChunkPos[0] != currentChunkPos) {
+                        cachedChunkAccess[0] = level.getChunkIfLoaded(chunkX, chunkZ);
+                        cachedChunkPos[0] = currentChunkPos;
+                    }
+
+                    if (cachedChunkAccess[0] != null) {
+                        state = cachedChunkAccess[0].getBlockState(pos);
+                    } else {
+                        BlockState loaded = level.getBlockStateIfLoaded(pos);
+
+                        if (loaded == null) {
+                            loaded = Blocks.AIR.defaultBlockState();
+                        }
+
+                        state = loaded;
+                    }
+
+                    if (state.isAir()) {
+                        if (hasIntersectionSubscriber) {
+                            debugBlockIntersection((ServerLevel) level, pos, false, false);
+                        }
+
+                        ++index;
+
+                        continue;
+                    }
+
+                    final VoxelShape insideCollision = state.getEntityInsideCollisionShape(level, pos, this);
+                    final FluidState fluidState = state.getFluidState();
+
+                    final boolean insideBlock = insideCollision == Shapes.block()
+                        || collidedWithShapeMovingFrom(from, to, insideCollision.move(new Vec3(pos)));
+
+                    final boolean insideFluid = !fluidState.isEmpty() && collidedWithFluid(fluidState, pos, from, to);
+
+                    if ((insideBlock || insideFluid) && visited.add(pos.asLong())) {
+                        if (insideBlock) {
+                            try {
+                                stepBasedCollector.advanceStep(index, pos);
+
+                                state.entityInside(level, pos, this, stepBasedCollector, true);
+
+                                onInsideBlock(state);
+                            } catch (final Throwable throwable) {
+                                final CrashReport crashReport = CrashReport.forThrowable(throwable, "Colliding entity with block");
+                                final CrashReportCategory blockCategory = crashReport.addCategory("Block being collided with");
+
+                                CrashReportCategory.populateBlockDetails(blockCategory, level(), pos, state);
+
+                                final CrashReportCategory entityCategory = crashReport.addCategory("Entity being checked for collision");
+
+                                fillCrashReportCategory(entityCategory);
+
+                                throw new ReportedException(crashReport);
+                            }
+                        }
+
+                        if (insideFluid) {
+                            stepBasedCollector.advanceStep(index, pos);
+
+                            fluidState.entityInside(level, pos, this, stepBasedCollector);
+                        }
+                    }
+
+                    if (hasIntersectionSubscriber) {
+                        debugBlockIntersection((ServerLevel)level, pos, insideBlock, insideFluid);
+                    }
+
+                    ++index;
+                }
+            }
+        }
+
+        return index;
     }
     // Leaf end - optimize checkInsideBlocks calls
 
