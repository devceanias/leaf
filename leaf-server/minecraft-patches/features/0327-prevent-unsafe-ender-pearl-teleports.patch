+    private @Nullable Vec3 findPearlTarget(final ServerPlayer player, final ServerLevel level, final Vec3 hit) {
+        final BlockPos pos = BlockPos.containing(hit);
+
+        Vec3 target = hit;
+
+        if (level.getBlockState(pos).is(Blocks.BARRIER) ||
+            level.getBlockState(pos.above()).is(Blocks.BARRIER)
+        ) {
+            target = findBarrierSafe(level, target);
+
+            if (target == null) {
+                return null;
+            }
+        }
+
+        final BlockPos result = BlockPos.containing(target);
+
+        final Vec3 snapped = new Vec3(
+            result.getX() + 0.5D,
+            result.getY(),
+            result.getZ() + 0.5D
+        );
+
+        return isTargetSafe(player, level, snapped) ? snapped : null;
+    }
+
+    private @Nullable Vec3 findBarrierSafe(final ServerLevel level, final Vec3 position) {
+        final BlockPos containing = BlockPos.containing(position);
+
+        final int x = containing.getX();
+        final int z = containing.getZ();
+
+        for (int y = containing.getY(); y >= level.getMinY(); y--) {
+            final BlockPos floorPos = new BlockPos(x, y, z);
+            final BlockState floorState = level.getBlockState(floorPos);
+
+            if (floorState.getCollisionShape(level, floorPos).isEmpty() || floorState.is(Blocks.BARRIER)) {
+                continue;
+            }
+
+            return new Vec3(x + 0.5D, y + 1.0D, z + 0.5D);
+        }
+
+        return null;
+    }
+
+    private boolean isTargetSafe(final ServerPlayer player, final ServerLevel level, final Vec3 position) {
+        final AABB boundingBox = player.getDimensions(player.getPose()).makeBoundingBox(position);
+
+        final int minX = Mth.floor(boundingBox.minX);
+        final int maxX = Mth.floor(boundingBox.maxX);
+        final int minY = Mth.floor(boundingBox.minY);
+        final int maxY = Mth.floor(boundingBox.maxY);
+        final int minZ = Mth.floor(boundingBox.minZ);
+        final int maxZ = Mth.floor(boundingBox.maxZ);
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int y = minY; y <= maxY; y++) {
+                for (int z = minZ; z <= maxZ; z++) {
+                    final BlockPos pos = new BlockPos(x, y, z);
+
+                    for (final AABB shape : level.getBlockState(pos).getCollisionShape(level, pos).toAabbs()) {
+                        if (!shape.move(pos).intersects(boundingBox)) {
+                            continue;
+                        }
+
+                        return false;
+                    }
+                }
+            }
+        }
+
+        return true;
+    }
+
