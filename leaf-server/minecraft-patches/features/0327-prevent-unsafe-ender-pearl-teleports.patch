+    private Vec3 resolvePearlTarget(final ServerPlayer player, final ServerLevel level, final HitResult result) {
+        final Vec3 hit = result.getLocation();
+
+        if (!(result instanceof final BlockHitResult block)) {
+            return hit;
+        }
+
+        final Direction face = resolveHitFace(level, block);
+        final BlockPos pos = block.getBlockPos();
+        final EntityDimensions dimensions = player.getDimensions(player.getPose());
+
+        return switch (face) {
+            case UP -> resolveTopHit(player, level, block, pos, dimensions, hit);
+            case DOWN -> resolveBottomHit(player, level, block, pos, dimensions, hit);
+            default -> resolveSideHit(player, level, block, pos, face, dimensions, hit);
+        };
+    }
+
+    private Direction resolveHitFace(final ServerLevel level, final BlockHitResult hit) {
+        final Direction face = hit.getDirection();
+
+        if (face != Direction.UP && face != Direction.DOWN) {
+            return face;
+        }
+
+        final Vec3 delta = getDeltaMovement();
+        final double horizontal = Math.max(Math.abs(delta.x), Math.abs(delta.z));
+        final double vertical = Math.abs(delta.y);
+        final Direction sideFace = findHorizontalFace(delta);
+
+        if (horizontal < PEARL_HORIZONTAL_RECLASSIFY ||
+            vertical > horizontal * PEARL_VERTICAL_CLASSIFY ||
+            !isHorizontalEdge(hit) ||
+            !hasHorizontalObstruction(level, hit.getBlockPos(), sideFace)
+        ) {
+            return face;
+        }
+
+        return sideFace;
+    }
+
+    private boolean isHorizontalEdge(final BlockHitResult hit) {
+        final Vec3 location = hit.getLocation();
+        final BlockPos pos = hit.getBlockPos();
+
+        final double x = location.x - pos.getX();
+        final double z = location.z - pos.getZ();
+
+        final double distance = Math.min(
+            Math.min(x, 1.0 - x),
+            Math.min(z, 1.0 - z)
+        );
+
+        return distance <= PEARL_EDGE_RECLASSIFY;
+    }
+
+    private boolean hasHorizontalObstruction(final ServerLevel level, final BlockPos pos, final Direction face) {
+        final BlockPos front = pos.relative(face);
+        final BlockPos head = front.above();
+        final BlockPos upper = head.above();
+
+        return !level.getBlockState(head).getCollisionShape(level, head).isEmpty()
+            || !level.getBlockState(upper).getCollisionShape(level, upper).isEmpty();
+    }
+
+    private Direction findHorizontalFace(final Vec3 delta) {
+        if (Math.abs(delta.x) >= Math.abs(delta.z)) {
+            return delta.x > 0.0 ? Direction.WEST : Direction.EAST;
+        }
+
+        return delta.z > 0.0 ? Direction.NORTH : Direction.SOUTH;
+    }
+
+    private @Nullable Vec3 findFreeTarget(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final EntityDimensions dimensions,
+        final Vec3 candidate
+    ) {
+        final AABB box = dimensions.makeBoundingBox(candidate);
+
+        if (level.noCollision(player, box) && !level.containsAnyLiquid(box)) {
+            return candidate;
+        }
+
+        return level.findFreePosition(player, Shapes.create(box), candidate, PEARL_FREE_XZ, PEARL_FREE_Y, PEARL_FREE_XZ)
+            .filter(target -> {
+                final AABB targetBox = dimensions.makeBoundingBox(target);
+
+                return level.noCollision(player, targetBox) && !level.containsAnyLiquid(targetBox);
+            })
+            .orElse(null);
+    }
+
+    private Vec3 resolveTopHit(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final BlockHitResult result,
+        final BlockPos pos,
+        final EntityDimensions dimensions,
+        final Vec3 hit
+    ) {
+        final int originalX = pos.getX();
+        final int originalZ = pos.getZ();
+
+        final double clampedX = clamp(hit.x, originalX + 0.15, originalX + 0.85);
+        final int blockY = pos.getY();
+        final double clampedY = clamp(hit.z, originalZ + 0.15, originalZ + 0.85);
+
+        final Vec3[] targetCandidates = {
+            new Vec3(clampedX, blockY + 1.0, clampedY),
+            new Vec3(originalX + 0.5, blockY + 1.0, originalZ + 0.5),
+            new Vec3(originalX + 0.25, blockY + 1.0, originalZ + 0.25),
+            new Vec3(originalX + 0.25, blockY + 1.0, originalZ + 0.75),
+            new Vec3(originalX + 0.75, blockY + 1.0, originalZ + 0.25),
+            new Vec3(originalX + 0.75, blockY + 1.0, originalZ + 0.75)
+        };
+
+        final Vec3 resolvedTarget = resolveWithinCell(
+            player, level, dimensions, targetCandidates, pos, blockY + 1.0 - PEARL_FACE_EPSILON, Double.MAX_VALUE
+        );
+
+        if (resolvedTarget != null) {
+            logPearlTarget(result, hit, resolvedTarget, "up-cell");
+
+            return resolvedTarget;
+        }
+
+        final Direction sideDirection = findHorizontalFace(getDeltaMovement());
+        final Vec3 sideTarget = resolveSideHit(player, level, result, pos, sideDirection, dimensions, hit);
+
+        if (sideTarget.distanceToSqr(player.position()) > 0.01) {
+            logPearlTarget(result, hit, sideTarget, "up-side");
+
+            return sideTarget;
+        }
+
+        logPearlTarget(result, hit, new Vec3(originalX + 0.5, blockY + 1.0, originalZ + 0.5), "up-final");
+
+        return new Vec3(originalX + 0.5, blockY + 1.0, originalZ + 0.5);
+    }
+
+    private Vec3 resolveBottomHit(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final BlockHitResult result,
+        final BlockPos pos,
+        final EntityDimensions dimensions,
+        final Vec3 hit
+    ) {
+        final int originalX = pos.getX();
+        final int originalY = pos.getY();
+
+        final float dimensionsHeight = dimensions.height();
+
+        final int originalZ = pos.getZ();
+
+        final double clampedX = clamp(hit.x, originalX + 0.15, originalX + 0.85);
+        final double clampedY = originalY - dimensionsHeight - PEARL_FACE_EPSILON;
+        final double clampedZ = clamp(hit.z, originalZ + 0.15, originalZ + 0.85);
+
+        final Vec3[] targetCandidates = {
+            new Vec3(clampedX, clampedY, clampedZ),
+            new Vec3(originalX + 0.5, clampedY, originalZ + 0.5),
+            new Vec3(originalX + 0.25, clampedY, originalZ + 0.25),
+            new Vec3(originalX + 0.25, clampedY, originalZ + 0.75),
+            new Vec3(originalX + 0.75, clampedY, originalZ + 0.25),
+            new Vec3(originalX + 0.75, clampedY, originalZ + 0.75)
+        };
+
+        final Vec3 resolvedTarget = resolveWithinCell(
+            player,
+            level,
+            dimensions,
+            targetCandidates,
+            pos,
+            Double.NEGATIVE_INFINITY,
+            originalY + PEARL_FACE_EPSILON - dimensionsHeight
+        );
+
+        if (resolvedTarget != null) {
+            logPearlTarget(result, hit, resolvedTarget, "down-cell");
+
+            return resolvedTarget;
+        }
+
+        final Direction sideDirection = findHorizontalFace(getDeltaMovement());
+        final Vec3 sideTarget = resolveSideHit(player, level, result, pos, sideDirection, dimensions, hit);
+
+        if (sideTarget.distanceToSqr(player.position()) > 0.01) {
+            logPearlTarget(result, hit, sideTarget, "down-side");
+
+            return sideTarget;
+        }
+
+        logPearlTarget(result, hit, new Vec3(originalX + 0.5, clampedY, originalZ + 0.5), "down-final");
+
+        return new Vec3(originalX + 0.5, clampedY, originalZ + 0.5);
+    }
+
+    private Vec3 resolveSideHit(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final BlockHitResult result,
+        final BlockPos pos,
+        final Direction face,
+        final EntityDimensions dimensions,
+        final Vec3 hit
+    ) {
+        final BlockPos frontBasePos = pos.relative(face);
+
+        final Direction direction = face.getClockWise();
+        final double y = hit.y;
+
+        final BlockPos faceClockwisePos = frontBasePos.relative(direction);
+        final BlockPos faceCounterPos = frontBasePos.relative(direction.getOpposite());
+
+        final Vec3 front = resolveSideCell(player, level, dimensions, hit, frontBasePos, y, "side-front", result);
+        final BlockPos frontDownPos = frontBasePos.below();
+
+        final BlockPos clockwiseDownPos = faceClockwisePos.below();
+        final BlockPos counterDownPos = faceCounterPos.below();
+
+        if (front != null) {
+            return front;
+        }
+
+        final Vec3 fdown = resolveSideCell(
+            player, level, dimensions, hit, frontDownPos, y - 0.5, "side-front-down", result
+        );
+
+        if (fdown != null) {
+            return fdown;
+        }
+
+        final Vec3 clockwise = resolveSideCell(
+            player, level, dimensions, hit, faceClockwisePos, y, "side-diagonal-cw", result
+        );
+
+        if (clockwise != null) {
+            return clockwise;
+        }
+
+        final Vec3 counter = resolveSideCell(
+            player, level, dimensions, hit, faceCounterPos, y, "side-diagonal-ccw", result
+        );
+
+        if (counter != null) {
+            return counter;
+        }
+
+        final Vec3 cwdown = resolveSideCell(
+            player, level, dimensions, hit, clockwiseDownPos, y - 0.5, "side-diagonal-cw-down", result
+        );
+
+        if (cwdown != null) {
+            return cwdown;
+        }
+
+        final Vec3 ccdown = resolveSideCell(
+            player, level, dimensions, hit, counterDownPos, y - 0.5, "side-diagonal-ccw-down", result
+        );
+
+        if (ccdown != null) {
+            return ccdown;
+        }
+
+        final Vec3 fallback = new Vec3(frontBasePos.getX() + 0.5, y, frontBasePos.getZ() + 0.5);
+
+        logPearlTarget(result, hit, fallback, "side-front-final");
+
+        return fallback;
+    }
+
+    private @Nullable Vec3 resolveSideCell(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final EntityDimensions dimensions,
+        final Vec3 hit,
+        final BlockPos cell,
+        final double y,
+        final String mode,
+        final BlockHitResult result
+    ) {
+        final int originalX = cell.getX();
+        final int originalZ = cell.getZ();
+
+        final double clampedX = clamp(hit.x, originalX + 0.15, originalX + 0.85);
+        final double clampedZ = clamp(hit.z, originalZ + 0.15, originalZ + 0.85);
+
+        final Vec3[] targetCandidates = {
+            new Vec3(clampedX, y, clampedZ),
+            new Vec3(originalX + 0.5, y, originalZ + 0.5),
+            new Vec3(originalX + 0.25, y, originalZ + 0.25),
+            new Vec3(originalX + 0.25, y, originalZ + 0.75),
+            new Vec3(originalX + 0.75, y, originalZ + 0.25),
+            new Vec3(originalX + 0.75, y, originalZ + 0.75),
+            new Vec3(originalX + 0.5, y - 0.125, originalZ + 0.5),
+            new Vec3(originalX + 0.5, y + 0.125, originalZ + 0.5),
+            new Vec3(originalX + 0.25, y - 0.125, originalZ + 0.25),
+            new Vec3(originalX + 0.25, y - 0.125, originalZ + 0.75),
+            new Vec3(originalX + 0.75, y - 0.125, originalZ + 0.25),
+            new Vec3(originalX + 0.75, y - 0.125, originalZ + 0.75),
+            new Vec3(originalX + 0.25, y + 0.125, originalZ + 0.25),
+            new Vec3(originalX + 0.25, y + 0.125, originalZ + 0.75),
+            new Vec3(originalX + 0.75, y + 0.125, originalZ + 0.25),
+            new Vec3(originalX + 0.75, y + 0.125, originalZ + 0.75)
+        };
+
+        final Vec3 resolvedTarget = resolveWithinCell(
+            player,
+            level,
+            dimensions,
+            targetCandidates,
+            cell,
+            y - PEARL_SIDE_Y_RANGE,
+            y + PEARL_SIDE_Y_RANGE
+        );
+
+        if (resolvedTarget != null) {
+            logPearlTarget(result, hit, resolvedTarget, mode);
+
+            return resolvedTarget;
+        }
+
+        return null;
+    }
+
+    private @Nullable Vec3 resolveWithinCell(
+        final ServerPlayer player,
+        final ServerLevel level,
+        final EntityDimensions dims,
+        final Vec3[] candidates,
+        final BlockPos cell,
+        final double minY,
+        final double maxY
+    ) {
+        final int cellX = cell.getX();
+        final int cellZ = cell.getZ();
+
+        final double minX = cellX + 0.05;
+        final double maxX = cellX + 0.95;
+        final double minZ = cellZ + 0.05;
+        final double maxZ = cellZ + 0.95;
+
+        for (final Vec3 candidate : candidates) {
+            final Vec3 target = this.findFreeTarget(player, level, dims, candidate);
+
+            if (target == null) {
+                continue;
+            }
+
+            if (target.x < minX || target.x > maxX || target.z < minZ || target.z > maxZ) {
+                continue;
+            }
+
+            if (target.y < minY || target.y > maxY) {
+                continue;
+            }
+
+            return target;
+        }
+
+        return null;
+    }
+
+    private void logPearlTarget(final BlockHitResult hit, final Vec3 original, final Vec3 target, final String mode) {
+        if (!EnderPearlMechanics.logActions) {
+            return;
+        }
+
+        System.out.println(
+            "[pearls]"
+                + " face=" + hit.getDirection()
+                + " block=" + hit.getBlockPos()
+                + " original=" + formatVec3(original)
+                + " target=" + formatVec3(target)
+                + " mode=" + mode
+        );
+    }
+
+    private String formatVec3(final Vec3 vec) {
+        return round(vec.x) + "," + round(vec.y) + "," + round(vec.z);
+    }
+
+    private double round(final double value) {
+        return Math.round(value * 1000.0) / 1000.0;
+    }
+
+    private double clamp(final double value, final double min, final double max) {
+        return Math.max(min, Math.min(max, value));
+    }
+
     @Override
     public void tick() {
         if (this.level() instanceof ServerLevel serverLevel) {
