From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: plantball <mythicalplanetdude@gmail.com>
Date: Sun, 26 Apr 2026 17:40:54 +1000
Subject: [PATCH] disable block survival checks


diff --git a/net/minecraft/world/level/block/state/BlockBehaviour.java b/net/minecraft/world/level/block/state/BlockBehaviour.java
index b6f319824fb353c0b783fc4b2e732792653b0d79..6a2eeb5788159244c1db1dfa6d11a5484ae13568 100644
--- a/net/minecraft/world/level/block/state/BlockBehaviour.java
+++ b/net/minecraft/world/level/block/state/BlockBehaviour.java
@@ -82,6 +82,7 @@ import net.minecraft.world.phys.Vec3;
 import net.minecraft.world.phys.shapes.CollisionContext;
 import net.minecraft.world.phys.shapes.Shapes;
 import net.minecraft.world.phys.shapes.VoxelShape;
+import org.dreeam.leaf.config.modules.gameplay.BlockSurvivalChecks;
 import org.jspecify.annotations.Nullable;
 
 public abstract class BlockBehaviour implements FeatureElement {
@@ -965,6 +966,10 @@ public abstract class BlockBehaviour implements FeatureElement {
         }
 
         public boolean canSurvive(LevelReader level, BlockPos pos) {
+            if (!BlockSurvivalChecks.enabled) {
+                return true;
+            }
+
             return this.getBlock().canSurvive(this.asState(), level, pos);
         }
 
