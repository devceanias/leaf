From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: plantball <mythicalplanetdude@gmail.com>
Date: Sun, 26 Apr 2026 15:51:26 +1000
Subject: [PATCH] limit item merge attempts per tick


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index c1e7c04b048099dab7bb4cabdcb53add2201247f..fe52bb4f3ac32a92b8a2eb7de12c28be47b512b0 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -33,6 +33,7 @@ import net.minecraft.world.level.portal.TeleportTransition;
 import net.minecraft.world.level.storage.ValueInput;
 import net.minecraft.world.level.storage.ValueOutput;
 import net.minecraft.world.phys.Vec3;
+import org.dreeam.leaf.config.modules.opt.ItemMergeAttempts;
 import org.jspecify.annotations.Nullable;
 
 public class ItemEntity extends Entity implements TraceableEntity {
@@ -61,6 +62,9 @@ public class ItemEntity extends Entity implements TraceableEntity {
     public boolean immuneToLightning = false;
     // Purpur end - Item entity immunities
 
+    private static int mergeAttemptsThisTick = 0;
+    private static int mergeAttemptsTickNumber = Integer.MIN_VALUE;
+
     public ItemEntity(EntityType<? extends ItemEntity> type, Level level) {
         super(type, level);
         this.setYRot(this.random.nextFloat() * 360.0F);
@@ -282,9 +286,27 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
     private void mergeWithNeighbours() {
         if (this.isMergable()) {
-            double radius = this.level().spigotConfig.itemMerge; // Spigot
+            final int max = ItemMergeAttempts.maxPerTick;
+
+            if (max == 0) {
+                return;
+            }
+
+            final int current = net.minecraft.server.MinecraftServer.currentTick;
+
+            if (mergeAttemptsTickNumber != current) {
+                mergeAttemptsTickNumber = current;
+                mergeAttemptsThisTick = 0;
+            }
+
+            final double radius = this.level().spigotConfig.itemMerge; // Spigot
+
             for (ItemEntity itemEntity : this.level()
                 .getEntitiesOfClass(ItemEntity.class, this.getBoundingBox().inflate(radius, this.level().paperConfig().entities.behavior.onlyMergeItemsHorizontally ? 0 : radius - 0.5D, radius), neighbour -> neighbour != this && neighbour.isMergable())) { // Spigot // Paper - configuration to only merge items horizontally
+                if (max >= 0 && mergeAttemptsThisTick >= max) {
+                    break;
+                }
+
                 if (itemEntity.isMergable()) {
                     // Paper start - Fix items merging through walls
                     if (this.level().paperConfig().fixes.fixItemsMergingThroughWalls) {
@@ -294,7 +316,10 @@ public class ItemEntity extends Entity implements TraceableEntity {
                         }
                     }
                     // Paper end - Fix items merging through walls
+                    mergeAttemptsThisTick++;
+
                     this.tryToMerge(itemEntity);
+
                     if (this.isRemoved()) {
                         break;
                     }
