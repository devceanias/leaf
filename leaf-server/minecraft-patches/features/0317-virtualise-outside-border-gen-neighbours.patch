+    private static final class VirtualBorderGenerationChunkHolder extends GenerationChunkHolder {
+        private final ChunkAccess chunk;
+
+        private VirtualBorderGenerationChunkHolder(final ServerLevel world, final int chunkX, final int chunkZ) {
+            super(new ChunkPos(chunkX, chunkZ));
+
+            final ProtoChunk chunk = new ProtoChunk(
+                pos, UpgradeData.EMPTY, world, world.palettedContainerFactory(), null
+            );
+
+            chunk.setPersistedStatus(ChunkStatus.FULL);
+
+            this.chunk = chunk;
+        }
+
+        @Override
+        protected void addSaveDependency(final @NonNull CompletableFuture<?> saveDependency) {}
+
+        @Override
+        public void increaseGenerationRefCount() {}
+
+        @Override
+        public void decreaseGenerationRefCount() {}
+
+        @Override
+        public ChunkAccess getChunkIfPresentUnchecked(final @NonNull ChunkStatus status) {
+            return chunk;
+        }
+
+        @Override
+        public ChunkAccess getChunkIfPresent(final @NonNull ChunkStatus status) {
+            return chunk;
+        }
+
+        @Override
+        public ChunkAccess getLatestChunk() {
+            return chunk;
+        }
+
+        @Override
+        public ChunkStatus getPersistedStatus() {
+            return chunk.getPersistedStatus();
+        }
+
+        @Override
+        public @NonNull FullChunkStatus getFullStatus() {
+            return FullChunkStatus.INACCESSIBLE;
+        }
+
+        @Override
+        public int getTicketLevel() {
+            return ChunkLevel.byStatus(ChunkStatus.FULL);
+        }
+
+        @Override
+        public int getQueueLevel() {
+            return 0;
+        }
+    }
 
