diff --git a/net/minecraft/core/RegistrySynchronization.java b/net/minecraft/core/RegistrySynchronization.java
index ba8d32fd6fb1c255ea77d076ab2bbc134c7fe7be..b85d337a84da842b7b756ce39d06b3f734015a46 100644
--- a/net/minecraft/core/RegistrySynchronization.java
+++ b/net/minecraft/core/RegistrySynchronization.java
@@ -44,32 +44,59 @@ public class RegistrySynchronization {
         registryAccess.lookup(registryData.key())
             .ifPresent(
                 registry -> {
-                    List<RegistrySynchronization.PackedRegistryEntry> list = new ArrayList<>(registry.size());
-                    registry.listElements()
-                        .forEach(
-                            value -> {
-                                boolean isPresent = registry.registrationInfo(value.key())
-                                    .flatMap(RegistrationInfo::knownPackInfo)
-                                    .filter(packs::contains)
-                                    .isPresent();
-                                Optional<Tag> optional;
-                                if (isPresent) {
-                                    optional = Optional.empty();
-                                } else {
-                                    Tag tag = registryData.elementCodec()
-                                        .encodeStart(ops, value.value())
-                                        .getOrThrow(string -> new IllegalArgumentException("Failed to serialize " + value.key() + ": " + string));
-                                    optional = Optional.of(tag);
-                                }
-
-                                list.add(new RegistrySynchronization.PackedRegistryEntry(value.key().identifier(), optional));
-                            }
-                        );
+                    final List<RegistrySynchronization.PackedRegistryEntry> list;
+
+                    if (registry instanceof final MappedRegistry<T> mappedRegistry) {
+                        final List<MappedRegistry.SnapshotEntry<T>> snapshot = mappedRegistry.snapshotRegistryEntries();
+
+                        list = new ArrayList<>(snapshot.size());
+
+                        for (final MappedRegistry.SnapshotEntry<T> entry : snapshot) {
+                            list.add(packEntry(ops, registryData, packs, entry.key(), entry.value(), entry.registrationInfo()));
+                        }
+                    } else {
+                        list = new ArrayList<>(registry.size());
+
+                        registry.listElements().forEach(value -> list.add(
+                            packEntry(
+                                ops,
+                                registryData,
+                                packs,
+                                value.key(),
+                                value.value(),
+                                registry.registrationInfo(value.key()).orElse(null)
+                            )
+                        ));
+                    }
+
                     packetSender.accept(registry.key(), list);
                 }
             );
     }
 
+    private static <T> RegistrySynchronization.PackedRegistryEntry packEntry(
+        final DynamicOps<Tag> ops,
+        final RegistryDataLoader.RegistryData<T> registryData,
+        final Set<KnownPack> packs,
+        final ResourceKey<T> key,
+        final T value,
+        final RegistrationInfo registrationInfo
+    ) {
+        final Optional<Tag> data;
+
+        if (registrationInfo.knownPackInfo().filter(packs::contains).isPresent()) {
+            data = Optional.empty();
+        } else {
+            final Tag tag = registryData.elementCodec()
+                .encodeStart(ops, value)
+                .getOrThrow(string -> new IllegalArgumentException("Failed to serialize " + key + ": " + string));
+
+            data = Optional.of(tag);
+        }
+
+        return new RegistrySynchronization.PackedRegistryEntry(key.identifier(), data);
+    }
+
     private static Stream<RegistryAccess.RegistryEntry<?>> ownedNetworkableRegistries(RegistryAccess registryAccess) {
         return registryAccess.registries().filter(registry -> isNetworkable(registry.key()));
     }
