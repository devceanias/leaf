@@ -787,14 +784,35 @@ public class ServerGamePacketListenerImpl
                 return;
             }
 
-            this.player
-                .absSnapTo(
-                    this.awaitingPositionFromClient.x,
-                    this.awaitingPositionFromClient.y,
-                    this.awaitingPositionFromClient.z,
-                    this.player.getYRot(),
-                    this.player.getXRot()
+            try {
+                player
+                    .absSnapTo(
+                        awaitingPositionFromClient.x,
+                        awaitingPositionFromClient.y,
+                        awaitingPositionFromClient.z,
+                        player.getYRot(),
+                        player.getXRot()
+                    );
+            } catch (final IllegalStateException exception) {
+                LOGGER.warn(
+                    "Rejecting teleport acknowledge for {} because destination chunk is unavailable at ({}, {}, {})",
+                    player.getScoreboardName(),
+                    awaitingPositionFromClient.x,
+                    awaitingPositionFromClient.y,
+                    awaitingPositionFromClient.z,
+                    exception
                 );
+
+                player.absSnapTo(lastGoodX, lastGoodY, lastGoodZ, player.getYRot(), player.getXRot());
+
+                awaitingPositionFromClient = null;
+                awaitingTeleport = 0;
+
+                player.level().getChunkSource().move(player);
+
+                return;
+            }
+
             this.lastGoodX = this.awaitingPositionFromClient.x;
             this.lastGoodY = this.awaitingPositionFromClient.y;
             this.lastGoodZ = this.awaitingPositionFromClient.z;
@@ -1984,6 +2002,31 @@ public class ServerGamePacketListenerImpl
             posMoveRotation = new PositionMoveRotation(posMoveRotation.position(), posMoveRotation.deltaMovement(), posMoveRotation.yRot(), 0);
         }
 
+        final PositionMoveRotation absolutePosition = PositionMoveRotation.calculateAbsolute(
+            PositionMoveRotation.of(this.player),
+            posMoveRotation,
+            relatives
+        );
+
+        final int chunkX = SectionPos.blockToSectionCoord(Mth.floor(absolutePosition.position().x));
+        final int chunkZ = SectionPos.blockToSectionCoord(Mth.floor(absolutePosition.position().z));
+
+        try {
+            player.level().getChunkSource().getChunk(chunkX, chunkZ, ChunkStatus.FULL, true);
+        } catch (final IllegalStateException exception) {
+            LOGGER.warn(
+                "Rejecting teleport for {} because destination chunk is unavailable at ({}, {}, {}) in world {}",
+                player.getScoreboardName(),
+                absolutePosition.position().x,
+                absolutePosition.position().y,
+                absolutePosition.position().z,
+                player.level().getWorld().getName(),
+                exception
+            );
+
+            return;
+        }
+
         this.justTeleported = true;
         // CraftBukkit end
         this.awaitingTeleportTime = this.tickCount;
