+    public static final byte[] FULL_LIGHT_DATA = new byte[SWMRNibbleArray.ARRAY_SIZE];
+
+    private static final SWMRNibbleArray FULL_LIGHT_NIBBLE;
+    private static final ConcurrentHashMap<Integer, SWMRNibbleArray[]> FULL_LIGHT_CACHE = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<Integer, boolean[]> NON_EMPTY_SECTIONS = new ConcurrentHashMap<>();
+
+    static {
+        Arrays.fill(FULL_LIGHT_DATA, (byte)-1);
+        FULL_LIGHT_NIBBLE = new SWMRNibbleArray(FULL_LIGHT_DATA, true);
+    }
+
