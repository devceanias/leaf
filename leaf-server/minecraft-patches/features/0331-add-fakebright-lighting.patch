@@ -159,6 +171,39 @@ public abstract class StarLightEngine {
         }
     }
 
+    public static boolean isFakebright(final LevelHeightAccessor world) {
+        return world instanceof final Level level && level.galeConfig().smallOptimizations.applyFakebright;
+    }
+
+    public static SWMRNibbleArray[] getFilledFullLight(final LevelHeightAccessor world) {
+        return getFilledFullLight(WorldUtil.getTotalLightSections(world));
+    }
+
+    private static SWMRNibbleArray[] getFilledFullLight(final int totalLightSections) {
+        return FULL_LIGHT_CACHE.computeIfAbsent(totalLightSections, key -> {
+            final SWMRNibbleArray[] ret = new SWMRNibbleArray[key];
+
+            Arrays.fill(ret, FULL_LIGHT_NIBBLE);
+
+            return ret;
+        });
+    }
+
+    public static boolean[] getNonEmptySections(final LevelHeightAccessor world) {
+        return getNonEmptySections(WorldUtil.getTotalSections(world));
+    }
+
+    private static boolean[] getNonEmptySections(final int totalSections) {
+        return NON_EMPTY_SECTIONS.computeIfAbsent(totalSections, boolean[]::new);
+    }
+
+    public static void applyFakebright(final ChunkAccess chunk, final LevelHeightAccessor world) {
+        chunk.starlight$setBlockNibbles(getFilledFullLight(world));
+        chunk.starlight$setSkyNibbles(getFilledFullLight(world));
+        chunk.starlight$setBlockEmptinessMap(getNonEmptySections(world));
+        chunk.starlight$setSkyEmptinessMap(getNonEmptySections(world));
+    }
+
     protected final void setupEncodeOffset(final int centerX, final int centerY, final int centerZ) {
         // 31 = center + encodeOffset
         this.encodeOffsetX = 31 - centerX;
