-        this.connection.markClientUnloadedAfterDeath();
+
+        if (softRespawnResult == null) {
+            connection.markClientUnloadedAfterDeath();
+
+            return;
+        }
+
+        leaf$finishSoftRespawn(softRespawnResult);
+    }
+
+    public boolean shouldSoftRespawn() {
+        if (!SoftImmediateRespawn.enabled) {
+            return false;
+        }
+
+        if (!level().getGameRules().get(GameRules.IMMEDIATE_RESPAWN)) {
+            return false;
+        }
+
+        if (server.isHardcore()) {
+            return false;
+        }
+
+        if (connection.isDisconnected()) {
+            return false;
+        }
+
+        return !wonGame;
+    }
+
+    private void leaf$finishSoftRespawn(final ServerPlayer.RespawnResult result) {
+        final TeleportTransition transition = result.transition();
+        final ServerLevel level = level();
+
+        if (transition.newLevel() != level) {
+            connection.markClientUnloadedAfterDeath();
+
+            return;
+        }
+
+        if (isSleeping()) {
+            stopSleeping();
+        }
+
+        stopRiding(true);
+        setCamera(this);
+        reset();
+
+        dead = false;
+        invulnerableTime = 0;
+        hurtTime = 0;
+        hurtDuration = 0;
+
+        setPose(Pose.STANDING);
+        unsetRemoved();
+        setShiftKeyDown(false);
+
+        final Vec3 position = transition.position();
+
+        snapTo(position.x, position.y, position.z, transition.yRot(), transition.xRot());
+
+        connection.resetPosition();
+
+        level.getChunkSource().addTicketWithRadius(
+            TicketType.POST_TELEPORT,
+            new ChunkPos(Mth.floor(position.x()) >> 4, Mth.floor(position.z()) >> 4),
+            1
+        );
+
+        connection.internalTeleport(getX(), getY(), getZ(), getYRot(), getXRot());
+
+        connection.send(new ClientboundSetHealthPacket(
+            getBukkitEntity().getScaledHealth(), foodData.getFoodLevel(), foodData.getSaturationLevel()
+        ));
+
+        lastSentHealth = getHealth();
+        lastSentFood = foodData.getFoodLevel();
+        lastFoodSaturationZero = foodData.getSaturationLevel() == 0.0F;
+
+        connection.send(new ClientboundSetExperiencePacket(experienceProgress, totalExperience, experienceLevel));
+
+        lastSentExp = totalExperience;
+
+        onUpdateAbilities();
+
+        server.getPlayerList().sendActivePlayerEffects(this);
+        inventoryMenu.sendAllDataToRemote();
     }
 
     private void tellNeutralMobsThatIDied() {
@@ -1574,6 +1686,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
                     teleportTransition.postTeleportTransition(),
                     teleportTransition.cause());
             }
+
             // CraftBukkit end
             if (!teleportTransition.asPassenger()) {
                 this.removeVehicle();
