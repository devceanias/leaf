@@ -698,22 +713,74 @@ public final class RegionizedPlayerChunkLoader {
             return configLimit;
         }
 
+        private void refreshBorderTrackBounds() {
+            final boolean track = world.galeConfig().smallOptimizations.loadChunks.preventTrackingOutsideWorldBorder;
+
+            if (!track) {
+                trackByWorldBorder = false;
+
+                return;
+            }
+
+            final WorldBorder border = world.getWorldBorder();
+
+            trackByWorldBorder = true;
+            trackMinChunkX = Mth.floor(border.getMinX()) >> 4;
+            trackMaxChunkX = (Mth.ceil(border.getMaxX()) - 1) >> 4;
+            trackMinChunkZ = Mth.floor(border.getMinZ()) >> 4;
+            trackMaxChunkZ = (Mth.ceil(border.getMaxZ()) - 1) >> 4;
+        }
+
+        private void clearChunkViewCaches() {
+            sendChunkCache.clear();
+            tickChunkCache.clear();
+        }
+
         private boolean wantChunkSent(final int chunkX, final int chunkZ) {
+            final long chunk = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            final byte cached = sendChunkCache.get(chunk);
+
+            if (cached != 0) {
+                return cached == 1;
+            }
+
             final int dx = this.lastChunkX - chunkX;
             final int dz = this.lastChunkZ - chunkZ;
-            return (Math.max(Math.abs(dx), Math.abs(dz)) <= (this.lastSendDistance + 1)) && wantChunkLoaded(
+
+            final boolean result = (Math.max(Math.abs(dx), Math.abs(dz)) <= (this.lastSendDistance + 1)) && wantChunkLoaded(
                 this.lastChunkX, this.lastChunkZ, chunkX, chunkZ, this.lastSendDistance
             );
+
+            sendChunkCache.put(chunk, result ? (byte)1 : (byte)2);
+
+            return result;
         }
 
         private boolean wantChunkTicked(final int chunkX, final int chunkZ) {
+            final long chunk = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            final byte cached = tickChunkCache.get(chunk);
+
+            if (cached != 0) {
+                return cached == 1;
+            }
+
             final int dx = this.lastChunkX - chunkX;
             final int dz = this.lastChunkZ - chunkZ;
-            return Math.max(Math.abs(dx), Math.abs(dz)) <= this.lastTickDistance;
+
+            final boolean result = Math.max(Math.abs(dx), Math.abs(dz)) <= this.lastTickDistance;
+
+            tickChunkCache.put(chunk, result ? (byte)1 : (byte)2);
+
+            return result;
         }
 
         private boolean shouldTrackChunk(final int chunkX, final int chunkZ) {
-            return world.leaf$shouldTrackChunk(chunkX, chunkZ);
+            return !trackByWorldBorder || (
+                chunkX >= trackMinChunkX &&
+                chunkX <= trackMaxChunkX &&
+                chunkZ >= trackMinChunkZ &&
+                chunkZ <= trackMaxChunkZ
+            );
         }
 
         private boolean areNeighboursGenerated(final int chunkX, final int chunkZ, final int radius) {
