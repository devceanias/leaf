 import net.minecraft.tags.BlockTags;
 import net.minecraft.tags.DamageTypeTags;
 import net.minecraft.tags.EntityTypeTags;
-import net.minecraft.tags.FluidTags;
 import net.minecraft.tags.ItemTags;
 import net.minecraft.util.Mth;
 import net.minecraft.util.Unit;
@@ -119,7 +118,6 @@ import net.minecraft.world.level.storage.ValueOutput;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.Vec3;
 import net.minecraft.world.scores.PlayerTeam;
-import net.minecraft.world.scores.Team;
 import org.jspecify.annotations.Nullable;
 
 public abstract class Player extends Avatar implements ContainerUser {
@@ -163,6 +161,9 @@ public abstract class Player extends Avatar implements ContainerUser {
     public int experienceLevel = 0;
     public int totalExperience = 0;
     public float experienceProgress = 0.0F;
+
+    private boolean leaf$ignoreAttackCooldownReset;
+
     public int enchantmentSeed = 0;
     protected final float defaultFlySpeed = 0.02F;
     private int lastLevelUpTime;
@@ -2086,7 +2087,7 @@ public abstract class Player extends Avatar implements ContainerUser {
         // Copied from the tick method
         ItemStack mainHandItem = this.getMainHandItem();
         if (!ItemStack.matches(this.lastItemInMainHand, mainHandItem)) {
-            if (!ItemStack.isSameItem(this.lastItemInMainHand, mainHandItem)) {
+            if (!this.leaf$ignoreAttackCooldownReset && !ItemStack.isSameItem(this.lastItemInMainHand, mainHandItem)) {
                 this.resetAttackStrengthTicker();
             }
 
@@ -2095,6 +2096,10 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
     // Paper end - Force update attributes.
 
+    public void leaf$setIgnoreAttackCooldownReset(final boolean ignore) {
+        leaf$ignoreAttackCooldownReset = ignore;
+    }
+
     public void resetOnlyAttackStrengthTicker() {
         this.attackStrengthTicker = 0;
     }
