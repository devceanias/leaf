+            }
+
+            @Override
+            public void onSetWarningBlocks(final WorldBorder border, final int warningBlocks) {
+            }
+
+            @Override
+            public void onSetDamagePerBlock(final WorldBorder border, final double damagePerBlock) {
+            }
+
+            @Override
+            public void onSetSafeZone(final WorldBorder border, final double safeZone) {
+            }
+        });
+
         this.worldBorder = worldBorder; // Leaf - Cache world border
         return worldBorder;
     }
@@ -2608,15 +2656,15 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             return true;
         }
 
