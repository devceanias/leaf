-        return maxBlockX >= (int) Math.floor(worldBorder.getMinX()) && minBlockX <= (int) Math.ceil(worldBorder.getMaxX()) - 1
-            && maxBlockZ >= (int) Math.floor(worldBorder.getMinZ()) && minBlockZ <= (int) Math.ceil(worldBorder.getMaxZ()) - 1;
+        return maxBlockX >= (int) Math.floor(leaf$trackingBorderMinX) && minBlockX <= (int) Math.ceil(leaf$trackingBorderMaxX) - 1
+            && maxBlockZ >= (int) Math.floor(leaf$trackingBorderMinZ) && minBlockZ <= (int) Math.ceil(leaf$trackingBorderMaxZ) - 1;
     }
 
     public final boolean leaf$shouldAccessChunk(final int chunkX, final int chunkZ) {
@@ -2645,6 +2693,39 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         return false;
     }
 
+    private void leaf$setTrackingBorder(
+        final double centerX, final double centerZ, final double size, final int absoluteMaxSize
+    ) {
+        final double radius = size / 2.0;
+
+        leaf$trackingBorderMinX = Mth.clamp(centerX - radius, -absoluteMaxSize, absoluteMaxSize);
+        leaf$trackingBorderMaxX = Mth.clamp(centerX + radius, -absoluteMaxSize, absoluteMaxSize);
+        leaf$trackingBorderMinZ = Mth.clamp(centerZ - radius, -absoluteMaxSize, absoluteMaxSize);
+        leaf$trackingBorderMaxZ = Mth.clamp(centerZ + radius, -absoluteMaxSize, absoluteMaxSize);
+    }
+
+    private double leaf$getBorderSize() {
+        if (Double.isNaN(leaf$trackingBorderMinX)) {
+            return getWorldBorder().getSize();
+        }
+
+        return leaf$trackingBorderMaxX - leaf$trackingBorderMinX;
+    }
+
+    public final Vec3 clampToBorder(final double x, final double y, final double z) {
+        if (!galeConfig().smallOptimizations.loadChunks.preventTrackingOutsideWorldBorder) {
+            return new Vec3(x, y, z);
+        }
+
+        getWorldBorder();
+
+        return new Vec3(
+            Mth.clamp(x, leaf$trackingBorderMinX, leaf$trackingBorderMaxX - 1.0E-5F),
+            y,
+            Mth.clamp(z, leaf$trackingBorderMinZ, leaf$trackingBorderMaxZ - 1.0E-5F)
+        );
+    }
+
     // Leaf end - Do not track chunks outside the world border
 
     @Override
