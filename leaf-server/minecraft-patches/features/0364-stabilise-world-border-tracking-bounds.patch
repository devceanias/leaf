+                if (!(newSize > oldSize)) {
+                    return;
+                }
+
+                ServerLevel.this.leaf$setTrackingBorder(border.getCenterX(), border.getCenterZ(), newSize, border.getAbsoluteMaxSize());
+            }
+
+            @Override
+            public void onSetCenter(final WorldBorder border, final double x, final double z) {
+                ServerLevel.this.leaf$setTrackingBorder(x, z, ServerLevel.this.leaf$getBorderSize(), border.getAbsoluteMaxSize());
+            }
+
+            @Override
