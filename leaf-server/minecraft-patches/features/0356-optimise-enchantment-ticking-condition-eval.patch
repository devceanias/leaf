+
+        if (biomes.isEmpty() &&
+            structures.isEmpty() &&
+            smokey.isEmpty() &&
+            light.isEmpty() &&
+            block.isEmpty() &&
+            fluid.isEmpty() &&
+            canSeeSky.isEmpty()
+        ) {
+            return true;
+        }
+
+        if (!loaded) {
+            return false;
+        }
+
+        if (biomes.isPresent() && !biomes.get().contains(OptimizeBiome.advancement ? level.getBiomeCached(null, pos) : level.getBiome(pos))) { // Leaf - cache getBiome
             return false;
