+    private boolean matches(
+        final ServerLevel level, final double x, final double y, final double z, final BlockPos pos, final boolean loaded
+    ) {
+        if (position.isPresent() && !position.get().matches(x, y, z)) {
+            return false;
+        }
+
+        if (dimension.isPresent() && dimension.get() != (GlobalConfiguration.get().misc.strictAdvancementDimensionCheck ? level.dimension() : org.bukkit.craftbukkit.util.CraftDimensionUtil.getMainDimensionKey(level))) { // Paper - Add option for strict advancement dimension checks
