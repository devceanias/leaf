@@ -45,6 +45,7 @@ public class ItemEnchantments implements TooltipProvider {
     final it.unimi.dsi.fastutil.objects.Object2IntAVLTreeMap<Holder<Enchantment>> enchantments; // Paper
 
     private transient @Nullable ObjectArrayList<Entry<Holder<Enchantment>>> @Nullable [] leaf$tickingBySlot;
+    private transient @Nullable ObjectArrayList<Entry<Holder<Enchantment>>> @Nullable [] leaf$locationChangedBySlot;
 
     ItemEnchantments(it.unimi.dsi.fastutil.objects.Object2IntAVLTreeMap<Holder<Enchantment>> enchantments) { // Paper
         this.enchantments = enchantments;
@@ -141,6 +142,41 @@ public class ItemEnchantments implements TooltipProvider {
 
         return tickingEntries;
     }
+
+    @SuppressWarnings("unchecked")
+    public ObjectArrayList<Entry<Holder<Enchantment>>> locationChangedEntries(final net.minecraft.world.entity.EquipmentSlot slot) {
+        @Nullable ObjectArrayList<Entry<Holder<Enchantment>>> @Nullable [] list = leaf$locationChangedBySlot;
+
+        if (list == null) {
+            list = new ObjectArrayList[net.minecraft.world.entity.EquipmentSlot.VALUES_ARRAY.length];
+
+            leaf$locationChangedBySlot = list;
+        }
+
+        final int index = slot.ordinal();
+
+        ObjectArrayList<Entry<Holder<Enchantment>>> locationChangedEntries = list[index];
+
+        if (locationChangedEntries != null) {
+            return locationChangedEntries;
+        }
+
+        locationChangedEntries = new ObjectArrayList<>();
+
+        for (final Entry<Holder<Enchantment>> entry : enchantments.object2IntEntrySet()) {
+            final Enchantment enchantment = entry.getKey().value();
+
+            if (!enchantment.effects().has(EnchantmentEffectComponents.LOCATION_CHANGED) || !enchantment.matchingSlot(slot)) {
+                continue;
+            }
+
+            locationChangedEntries.add(entry);
+        }
+
+        list[index] = locationChangedEntries;
+
+        return locationChangedEntries;
+    }
     // Leaf end - cache slot-specific ticking enchantments
 
