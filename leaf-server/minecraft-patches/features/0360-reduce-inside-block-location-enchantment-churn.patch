     protected void onChangedBlock(ServerLevel level, BlockPos pos) {
+        final int tickCount = this.tickCount;
+        final long blockKey = pos.asLong();
+
+        if (lastChangedBlockTick == tickCount && lastChangedBlockKey == blockKey) {
+            return;
+        }
+
+        lastChangedBlockTick = tickCount;
+        lastChangedBlockKey = blockKey;
+
+        if (!hasLocationBasedEnchantments()) {
+            return;
+        }
+
         EnchantmentHelper.runLocationChangedEffects(level, this);
     }
 
@@ -2328,6 +2350,37 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         return this.activeLocationDependentEnchantments.computeIfAbsent(slot, equipmentSlot -> new Reference2ObjectArrayMap<>());
     }
 
+    private boolean hasLocationBasedEnchantments() {
+        if (!locationBasedEnchantmentsDirty) {
+            return hasLocationBasedEnchantments;
+        }
+
+        boolean has = false;
+
+        for (final EquipmentSlot slot : EquipmentSlot.VALUES_ARRAY) {
+            final ItemStack stack = getItemBySlot(slot);
+
+            if (stack.isEmpty()) {
+                continue;
+            }
+
+            final ItemEnchantments enchantments = stack.get(DataComponents.ENCHANTMENTS);
+
+            if (enchantments == null || enchantments.locationChangedEntries(slot).isEmpty()) {
+                continue;
+            }
+
+            has = true;
+
+            break;
+        }
+
+        locationBasedEnchantmentsDirty = false;
+        hasLocationBasedEnchantments = has;
+
+        return has;
+    }
+
